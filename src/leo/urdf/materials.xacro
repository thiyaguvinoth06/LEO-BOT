<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="base_light_gray">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>

  <!-- ================= WHEEL MATERIALS ================= -->

  <!-- Main drive wheel (rubber) -->
  <material name="wheel_rubber_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- Wheel rim / metal hub -->
  <material name="wheel_metal_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>


  <!-- ================= CASTER MATERIALS ================= -->

  <!-- Caster rubber wheel -->
  <material name="caster_rubber_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- Caster metal bracket -->
  <material name="caster_metal_silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <!-- Caster bolt / axle -->
  <material name="caster_axle_gray">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>


  <!-- ================= LIDAR MATERIALS ================= -->

  <!-- Lidar top housing (dark blue) -->
  <material name="lidar_dark_blue">
    <color rgba="0.05 0.10 0.40 1.0"/>
  </material>

  <!-- Lidar base / motor casing -->
  <material name="lidar_light_gray">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- Lidar black ring -->
  <material name="lidar_black_ring">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

</robot>